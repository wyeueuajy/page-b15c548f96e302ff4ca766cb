          "version": 3,
          "body": "<style>\n:root{--ink:#0b0c0b;--ink-2:#171917;--line:#2b2f2b;--paper:#101210;--text:#dfe4de;--muted:#8e9890;--acid:#c6f542;--acid-dim:#8fae2e;--white:#f4f7f1}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--ink);color:var(--text);font-family:\"Helvetica Neue\",Helvetica,Arial,\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:16px;line-height:1.7;letter-spacing:.01em}\na{color:var(--acid);text-decoration:none}\na:hover{text-decoration:underline}\nh1,h2,h3{line-height:1.25;margin:0;font-weight:700}\np{margin:0 0 1em}\n.wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n\n/* 顶部细横条导航 */\n.topbar{border-bottom:1px solid var(--line);background:var(--ink);position:sticky;top:0;z-index:20}\n.topbar .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;height:52px}\n.brandmark{font-size:14px;letter-spacing:.32em;text-transform:uppercase;color:var(--white);font-weight:700}\n.brandmark span{color:var(--acid)}\n.topnav{display:flex;gap:22px;flex-wrap:wrap}\n.topnav a{font-size:13px;color:var(--muted);letter-spacing:.08em}\n.topnav a:hover{color:var(--acid);text-decoration:none}\n\n/* 首屏：杂志式多栏网格配引言 */\n.hero{padding:56px 0 20px;border-bottom:1px solid var(--line)}\n.hero-grid{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:0;border-top:1px solid var(--line)}\n.hero-grid > div{padding:28px 26px 34px;border-bottom:1px solid var(--line);border-right:1px solid var(--line)}\n.hero-grid > div:first-child{padding-left:0}\n.hero-grid > div:last-child{border-right:0;padding-right:0}\n.kicker{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--acid);margin-bottom:18px}\nh1{font-size:clamp(38px,6.4vw,80px);letter-spacing:-.02em;color:var(--white);margin-bottom:18px}\nh1 em{font-style:normal;color:var(--acid)}\n.lede{font-size:17px;color:#c3cbc2;max-width:34ch}\n.col-note{font-size:14px;color:var(--muted)}\n.col-note strong{color:var(--white);font-weight:600}\n.pullquote{font-size:19px;line-height:1.55;color:var(--white);border-left:3px solid var(--acid);padding-left:16px;margin:0 0 18px}\n.quote-src{font-size:12px;letter-spacing:.14em;color:var(--muted);text-transform:uppercase}\n\n/* 通用区块 */\nsection{padding:64px 0;border-bottom:1px solid var(--line)}\n.sec-head{display:grid;grid-template-columns:200px 1fr;gap:24px;align-items:baseline;margin-bottom:40px}\n.sec-no{font-size:12px;letter-spacing:.28em;color:var(--acid-dim);text-transform:uppercase}\nh2{font-size:clamp(24px,3vw,34px);color:var(--white);letter-spacing:-.01em}\n.sec-sub{color:var(--muted);font-size:15px;margin-top:10px;max-width:62ch}\n\n/* 无边框卡片：仅靠留白 */\n.plain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:48px 56px}\n.plain-item h3{font-size:17px;color:var(--white);margin-bottom:8px}\n.plain-item .step{font-size:12px;letter-spacing:.24em;color:var(--acid);display:block;margin-bottom:10px}\n.plain-item p{font-size:15px;color:#b6bfb4;margin:0}\n\n/* 套餐：横向对比表格 */\n.table-scroll{overflow-x:auto;border-top:1px solid var(--line)}\ntable{width:100%;border-collapse:collapse;min-width:760px;font-size:15px}\nthead th{text-align:left;padding:20px 18px;vertical-align:bottom;border-bottom:1px solid var(--line);background:var(--ink-2)}\nthead th:first-child{padding-left:0;background:transparent;font-weight:400;color:var(--muted);font-size:13px;letter-spacing:.16em}\n.plan-name{font-size:18px;color:var(--white);display:block;letter-spacing:.02em}\n.plan-price{display:block;font-size:22px;color:var(--acid);margin-top:8px;letter-spacing:-.01em}\n.plan-price small{font-size:13px;color:var(--muted);letter-spacing:0}\n.rec{display:inline-block;margin-top:10px;font-size:11px;letter-spacing:.2em;color:var(--ink);background:var(--acid);padding:3px 8px;text-transform:uppercase}\ntbody th{text-align:left;padding:14px 18px;font-weight:400;color:var(--muted);font-size:14px;border-bottom:1px solid var(--line);white-space:nowrap}\ntbody th:first-child{padding-left:0}\ntbody td{padding:14px 18px;border-bottom:1px solid var(--line);color:#c9d1c7;vertical-align:top}\ntbody td.yes{color:var(--white)}\ntbody td.na{color:#5c655c}\ntfoot td{padding:22px 18px;font-size:14px;color:var(--muted)}\ntfoot td:first-child{padding-left:0}\n.table-note{font-size:13px;color:var(--muted);margin-top:16px;max-width:70ch}\n\n/* 客户端 */\n.client-row{display:grid;grid-template-columns:repeat(2,1fr);gap:40px 64px}\n.client-row h3{font-size:16px;color:var(--white);margin-bottom:6px}\n.client-row p{font-size:15px;color:#b6bfb4;margin:0}\n.client-row .tag{font-size:11px;letter-spacing:.2em;color:var(--acid-dim);text-transform:uppercase;display:block;margin-bottom:8px}\n\n/* FAQ 双栏 */\n.faq-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0 64px}\n.qa{padding:24px 0;border-top:1px solid var(--line)}\n.qa h3{font-size:16px;color:var(--white);margin-bottom:10px;font-weight:600}\n.qa h3::before{content:\"—\";color:var(--acid);margin-right:10px}\n.qa p{font-size:15px;color:#b6bfb4;margin:0}\n\n/* 页脚 */\nfooter{padding:44px 0 60px}\n.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:32px}\n.foot-grid p{font-size:14px;color:var(--muted);margin:0 0 8px}\n.foot-grid .lbl{font-size:11px;letter-spacing:.24em;color:var(--acid-dim);text-transform:uppercase;margin-bottom:10px}\n.foot-brand{font-size:14px;letter-spacing:.32em;color:var(--white);font-weight:700}\n\n@media (max-width:900px){\n  .hero-grid{grid-template-columns:1fr 1fr}\n  .hero-grid > div{border-right:0;padding:24px 0}\n  .plain-grid{grid-template-columns:1fr 1fr;gap:36px}\n  .sec-head{grid-template-columns:1fr;gap:8px}\n  .faq-grid{grid-template-columns:1fr;gap:0}\n  .foot-grid{grid-template-columns:1fr}\n}\n@media (max-width:620px){\n  .hero-grid{grid-template-columns:1fr}\n  .hero{padding-top:36px}\n  .plain-grid{grid-template-columns:1fr}\n  .client-row{grid-template-columns:1fr;gap:28px}\n  .topnav{gap:14px}\n  .topnav a{font-size:12px}\n  .topbar .wrap{height:auto;padding-top:12px;padding-bottom:12px;flex-wrap:wrap;justify-content:flex-start}\n  section{padding:48px 0}\n  h1{font-size:clamp(32px,9vw,52px)}\n}\n</style><header class=\"topbar\">\n  <div class=\"wrap\">\n    <div class=\"brandmark\">U<span>C</span>SS</div>\n    <nav class=\"topnav\" aria-label=\"页面目录\">\n      <a href=\"#plans\">套餐对照</a>\n      <a href=\"#howto\">订阅步骤</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n  <div class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-grid\">\n        <div>\n          <div class=\"kicker\">UCSS / 订阅说明 第 01 版</div>\n          <h1>UCSS 把<em>使用条件</em>写在前面</h1>\n          <p class=\"lede\">这一页不承诺速度，只把套餐的流量、设备数、线路类别和售后方式逐条列清，方便你在付款之前先判断是否合用。</p>\n        </div>\n        <div>\n          <blockquote class=\"pullquote\">“一份订阅说明最有价值的部分，不是形容词，而是你自己核对后能确认的那几行数字。”</blockquote>\n          <div class=\"quote-src\">UCSS 编写原则</div>\n        </div>\n        <div>\n          <p class=\"col-note\"><strong>本页结构</strong><br>套餐以横向表格对照，逐项列出流量额度、同时在线设备数与线路类别；订阅步骤按顺序说明准备、选择、配置三段；常见问题只回答已被问到的内容。</p>\n          <p class=\"col-note\">价格与权益同步自当前订阅表，未写明的项目一律视为未包含，不做额外推断。</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-no\">01 / 套餐对照</div>\n        <div>\n          <h2>三档订阅，按流量与设备数分开</h2>\n          <p class=\"sec-sub\">以下为当前在售的三档订阅。月付与年付的差别只在计费周期与总额，权益项目一致。年付金额按十二个月合并结算，不另行折算单月价格。</p>\n        </div>\n      </div>\n\n      <div class=\"table-scroll\">\n        <table>\n          UCSS 订阅对照表：基础版、旗舰版、团队版\n          <thead>\n            <tr>\n              <th>对照项</th>\n              <th>\n                <span class=\"plan-name\">基础版</span>\n                <span class=\"plan-price\">¥15 <small>/ 月</small></span>\n                <span class=\"plan-price\">年付 ¥150</span>\n              </th>\n              <th>\n                <span class=\"plan-name\">旗舰版</span>\n                <span class=\"plan-price\">¥35 <small>/ 月</small></span>\n                <span class=\"plan-price\">年付 ¥350</span>\n                <span class=\"rec\">推荐</span>\n              </th>\n              <th>\n                <span class=\"plan-name\">团队版</span>\n                <span class=\"plan-price\">¥85 <small>/ 月</small></span>\n                <span class=\"plan-price\">年付 ¥850</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月流量额度</th>\n              <td>100 GB</td>\n              <td>300 GB</td>\n              <td>1000 GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td>5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>线路类别</th>\n              <td>普通线路节点池</td>\n              <td>含 IPLC 专线节点</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>流媒体解锁</th>\n              <td>基础流媒体</td>\n              <td>全节点原生流媒体</td>\n              <td>全节点原生流媒体</td>\n            </tr>\n            <tr>\n              <th>游戏线路优化</th>\n              <td class=\"na\">未包含</td>\n              <td>IPLC 专线优化</td>\n              <td>IPLC 专线优化</td>\n            </tr>\n            <tr>\n              <th>路由设置</th>\n              <td class=\"na\">使用预设路由</td>\n              <td class=\"na\">使用预设路由</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>技术支持</th>\n              <td>常规工单</td>\n              <td>优先工单</td>\n              <td>专属客户经理</td>\n            </tr>\n          </tbody>\n          <tfoot>\n            <tr>\n              <td>计费说明</td>\n              <td>月付按月结算，年付一次性结算十二个月；套餐内流量按月重置，当月未用完的流量不结转到下月。切换套餐后的生效方式以你下单时页面的说明为准。</td>\n            </tr>\n          </tfoot>\n        </table>\n      </div>\n      <p class=\"table-note\">表格中没有列出的项目，代表该档订阅不包含，而不是“默认提供”。如果你需要的是定制路由或专属对接，只有团队版在表格中被标注支持。</p>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-no\">02 / 订阅步骤</div>\n        <div>\n          <h2>从确认需求到客户端可用</h2>\n          <p class=\"sec-sub\">整个过程分三段。第一段决定你该买哪一档，第二段完成订阅，第三段在设备上把订阅配置好。任何一段信息不全，都建议先停下来确认，而不是凭猜测继续。</p>\n        </div>\n      </div>\n\n      <div class=\"plain-grid\">\n        <div class=\"plain-item\">\n          <span class=\"step\">第一步</span>\n          <h3>清点设备与用量</h3>\n          <p>先数清楚会有几台设备同时在用同一个订阅，再回看你过去一个月的实际流量消耗。设备数超过三台，基础版就不再适用；用量长期接近 100 GB，就应直接考虑旗舰版。</p>\n        </div>\n        <div class=\"plain-item\">\n          <span class=\"step\">第二步</span>\n          <h3>确定档位与周期</h3>\n          <p>用对照表中同时在线设备与流量额度两行做筛选，其余权益作为次要判断。周期上，先按月付确认可用性，再考虑是否改为年付，避免为尚未验证的使用习惯预付一年。</p>\n        </div>\n        <div class=\"plain-item\">\n          <span class=\"step\">第三步</span>\n          <h3>准备客户端环境</h3>\n          <p>在系统层面先把客户端装好并确认能正常启动，再导入订阅配置。若客户端无法启动，问题与订阅无关，应先处理本机环境，比如系统版本、权限设置与网络代理残留。</p>\n        </div>\n        <div class=\"plain-item\">\n          <span class=\"step\">第四步</span>\n          <h3>导入并核对节点</h3>\n          <p>导入后核对节点列表是否与你所购档位的线路类别一致。基础版不应出现 VIP 专属节点，团队版也不应只看到普通节点池，出现不一致时先暂停使用并联系支持。</p>\n        </div>\n        <div class=\"plain-item\">\n          <span class=\"step\">第五步</span>\n          <h3>记录流量消耗</h3>\n          <p>在使用初期记录每日流量，用来判断当前档位的额度是否充裕。流量按月重置且不结转，因此在月中就接近上限时，应提前决定是升档还是压缩用量，而不是等到月底。</p>\n        </div>\n        <div class=\"plain-item\">\n          <span class=\"step\">第六步</span>\n          <h3>遇到问题先归类</h3>\n          <p>把问题分成“本机客户端”“订阅配置”“线路本身”三类，再提交工单。归类清楚的问题处理更快，也能让你在沟通时明确自己期望什么样的结果。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-no\">03 / 客户端</div>\n        <div>\n          <h2>客户端由你选择，UCSS 只提供订阅配置</h2>\n          <p class=\"sec-sub\">UCSS 不发布自有客户端安装包，也不提供下载地址。你使用自己已安装的通用客户端，导入订阅配置即可。下表说明各类系统上需要自行准备的内容。</p>\n        </div>\n      </div>\n\n      <div class=\"client-row\">\n        <div>\n          <span class=\"tag\">桌面端 / Windows 与 macOS</span>\n          <h3>自行准备一个通用客户端</h3>\n          <p>在系统上安装你信任的客户端，确认其支持导入订阅链接或配置文件。UCSS 不指定具体软件名称，也不对第三方客户端的运行结果作保证。</p>\n        </div>\n        <div>\n          <span class=\"tag\">移动端 / iOS 与 Android</span>\n          <h3>先确认应用商店可获取</h3>\n          <p>移动端需要从系统对应的应用商店中获取客户端，若商店内不可得，则无法通过官方途径安装。UCSS 不提供此类应用的安装包。</p>\n        </div>\n        <div>\n          <span class=\"tag\">路由器与其他设备</span>\n          <h3>按设备能力决定</h3>\n          <p>部分路由器支持导入配置，但可用性取决于设备固件本身。UCSS 不对具体型号作兼容性说明，请以设备说明书与固件功能为准。</p>\n        </div>\n        <div>\n          <span class=\"tag\">订阅配置本身</span>\n          <h3>只在你的账户内查看</h3>\n          <p>订阅配置属于账户信息，请不要转发给他人。同时在线设备数按订阅档位计算，超出会被限制，这一点与客户端数量无关。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-no\">04 / 常见问题</div>\n        <div>\n          <h2>被问得最多的几件事</h2>\n          <p class=\"sec-sub\">以下回答只覆盖本页已经写明的内容。若你的问题不在此列，请先对照套餐表格，再提交工单说明具体情况。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-grid\">\n        <div class=\"qa\">\n          <h3>流量当月没用完，会累积到下个月吗？</h3>\n          <p>不会。套餐内流量按月重置，未使用部分不结转。因此选择档位时，建议按你用量最高的月份来估算，而不是按平均值。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>同时在线设备数是怎么算的？</h3>\n          <p>按同一时间连线的设备数量计算，基础版 3 台、旗舰版 5 台、团队版 20 台。超出该数量时，多出的设备会被限制，需等已有设备断开或升级档位。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>年付和月付的权益有区别吗？</h3>\n          <p>没有。两者的权益项目一致，差别仅在计费周期与总额：基础版年付 ¥150、旗舰版年付 ¥350、团队版年付 ¥850，均为十二个月合并结算。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>我可以先买基础版再升级吗？</h3>\n          <p>可以按档位调整，但切换后的生效方式与费用处理，以你下单时页面上给出的说明为准。本页不预设升级规则，也不承诺折算方式。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>旗舰版和团队版的线路差别在哪？</h3>\n          <p>旗舰版包含 IPLC 专线节点并注明游戏线路优化；团队版使用 VIP 专属高带宽节点，并额外支持企业定制路由。基础版只有普通线路节点池。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>UCSS 提供客户端下载吗？</h3>\n          <p>不提供。UCSS 不发布自有客户端安装包，也不提供下载地址。你需要自行准备通用客户端，然后导入账户内的订阅配置。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>流媒体解锁在各档位有什么不同？</h3>\n          <p>基础版标注为基础流媒体；旗舰版与团队版为全节点原生流媒体。具体的可用范围与平台策略相关，本页不对某一平台作可用性保证。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>支持方式有什么区别？</h3>\n          <p>基础版为常规工单，旗舰版为优先工单，团队版提供专属客户经理。响应速度与服务范围不属于本页承诺内容，请以实际工单答复为准。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>流量接近上限时会提醒吗？</h3>\n          <p>本页不承诺任何提醒机制。建议你在使用初期自行记录每日消耗，判断是否需要提前升档，避免在月中才发现额度不足。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>我该怎样选择第一份订阅？</h3>\n          <p>按两步走：先数同时在线设备数量，再看月用量是否超过 100 GB。两项都较低选基础版；设备在五台以内且用量中等选旗舰版；需要定制路由或多人共用选团队版。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <div class=\"foot-brand\">UCSS</div>\n        <p>本页为订阅说明页面，内容以页面所列套餐表格为准。未写明的项目视为未包含。</p>\n      </div>\n      <div>\n        <div class=\"lbl\">页面目录</div>\n        <p><a href=\"#plans\">套餐对照</a></p>\n        <p><a href=\"#howto\">订阅步骤</a></p>\n        <p><a href=\"#clients\">客户端</a></p>\n        <p><a href=\"#faq\">常见问题</a></p>\n      </div>\n      <div>\n        <div class=\"lbl\">说明</div>\n        <p>价格：基础版 ¥15/月，旗舰版 ¥35/月，团队版 ¥85/月。</p>\n        <p>年付：¥150 / ¥350 / ¥850，按十二个月合并结算。</p>\n      </div>\n    </div>\n  </div>\n</footer>",
